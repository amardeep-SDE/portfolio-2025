# ==========================================
# Root .gitignore for Portfolio
# ==========================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Production & Build Outputs
dist/
dist-ssr/
build/
out/
coverage/
**/dist/
**/build/

# Vite & Tooling Cache
.vite/
**/.vite/
.cache/
**/.cache/
.eslintcache
*.tsbuildinfo

# Environment & Secret Variables (STRICT)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
.env.*
*.env
*.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Logs & Debug
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor Files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*~

# Temporary & Local files
*.local
