# Google Gemini API Key for Amardeep AI Copilot
# Get your 100% FREE API key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 🔒 Production Deployment Security Tip:
# When hosting on Vercel or Netlify:
# 1. Add VITE_GEMINI_API_KEY in your Vercel Project Settings -> Environment Variables.
# 2. In Google AI Studio (aistudio.google.com/api-keys), edit your key and set:
#    "Application restrictions" -> "Websites" (HTTP referrers) -> e.g. "https://your-portfolio.vercel.app/*"
# This guarantees no one else can copy or abuse your API quota on other sites!
